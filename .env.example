# ==============================================================================
# Database Configuration (Connects to shared FlatNFlatmates MongoDB)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=FlatNFlatmates
MONGODB_DB=flatnflatmates_dev
ENVIRONMENT=development

# ==============================================================================
# Property Collector Admin Authentication
# ==============================================================================
# Credentials checked on server-side
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
# Secret key used for signing session JWT cookies
SESSION_SECRET=your_random_secure_jwt_session_secret

# ==============================================================================
# App URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ==============================================================================
# Amazon S3 Object Storage (Shared Media Bucket with code_v2)
# ==============================================================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
INTERNAL_MEDIA_SECRET=your_internal_media_secret

# ==============================================================================
# Google Maps API Key (Optional client-side places & maps)
# ==============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
